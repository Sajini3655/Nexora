# Production Frontend Environment Variables
# Backend URL (Render deployment)
# This value MUST be set in Vercel Dashboard → Environment Variables
# because .env files are git-ignored and not accessible to Vercel during build
VITE_API_BASE_URL=https://nexora-ab6g.onrender.com

# Optional: Development services (comment out for production if not needed)
# VITE_DEVELOPER_APP_URL=https://your-developer-app-url.com
# VITE_AI_SERVICE_URL=https://your-ai-service-url.com

# Optional Supabase settings for client features
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# VITE_SUPABASE_CLIENT_PROJECTS_TABLE=client_projects
# VITE_SUPABASE_CLIENT_TICKETS_TABLE=client_tickets
# VITE_SUPABASE_CLIENT_PROFILES_TABLE=client_profiles
